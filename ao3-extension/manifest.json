{
  "manifest_version": 3,
  "name": "AO3 Work Tracker",
  "version": "2.0",
  "description": "Get Discord notifications when tracked AO3 works are updated",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://archiveofourown.org/*",
    "https://discord.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
