{
  "manifest_version": 3,
  "name": "Lorcana Price Tracker",
  "version": "1.0",
  "description": "Track Lorcana TCG prices and get Discord alerts twice daily",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://tcgcsv.com/*",
    "https://discord.com/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
